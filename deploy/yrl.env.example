# Where the gatekeeper listens (TCP), where it listens for the knock (UDP), which port is hidden behind the knock, and for how many seconds a knock opens it.
YRL_BIND=0.0.0.0:2222
YRL_SPA=0.0.0.0:2223
YRL_PORT=2222
YRL_KNOCK_TTL=30

# Per-session cgroup v2 limits for programs started by Executor. `cpu.max` is unlimited by
# default and IO uses only a fair-share weight, so normal file/compute throughput is not capped.
YRL_SESSION_MEMORY_HIGH=1G
YRL_SESSION_MEMORY_MAX=2G
YRL_SESSION_PIDS_MAX=512
YRL_SESSION_CPU_MAX="max 100000"
YRL_SESSION_CPU_WEIGHT=100
YRL_SESSION_IO_WEIGHT=100
# Optional, semicolon-separated block-device limits, for example:
# YRL_SESSION_IO_MAX="8:0 rbps=104857600 wbps=52428800;8:16 riops=5000 wiops=2500"
