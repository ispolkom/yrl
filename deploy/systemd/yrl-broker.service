[Unit]
Description=YRL broker (the only part that does typed privileged operations)
After=yrl-audit.service
Wants=yrl-audit.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=yrl-broker
Group=yrl-broker
SupplementaryGroups=yrl-to-audit yrl-to-broker
Environment=YRL_RUN=/run/yrl
Environment=YRL_SOCKET_GROUP=yrl-to-broker
ExecStart=/usr/local/bin/yrld broker /var/lib/yrl --exec-uid root --exec-exe -
Restart=on-failure
RestartSec=2
OOMPolicy=stop
MemoryHigh=128M
MemoryMax=256M
TasksMax=128
CPUWeight=100
IOWeight=100
MemoryAccounting=yes
TasksAccounting=yes
CPUAccounting=yes
IOAccounting=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/yrl/broker /run/yrl/broker
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
LimitCORE=0
KillMode=control-group
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=yrl.target
