[Unit]
Description=YRL gatekeeper (the only part that talks to the network)
After=yrl-audit.service yrl-executor.service yrl-firewall.service
Requires=yrl-audit.service yrl-executor.service yrl-firewall.service

[Service]
Type=simple
User=yrl-gate
Group=yrl-gate
SupplementaryGroups=yrl-conf yrl-to-audit yrl-to-exec yrl-to-fw
EnvironmentFile=/etc/yrl/yrl.env
Environment=YRL_RUN=/run/yrl
ExecStart=/usr/local/bin/yrld gatekeeper /var/lib/yrl ${YRL_BIND} --spa ${YRL_SPA} --work-port ${YRL_PORT} --knock-ttl ${YRL_KNOCK_TTL}
Restart=on-failure
RestartSec=2
CapabilityBoundingSet=
ReadWritePaths=/var/lib/yrl/enroll
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
KillMode=control-group
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=yrl.target
