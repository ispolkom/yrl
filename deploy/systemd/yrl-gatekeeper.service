[Unit]
Description=YRL gatekeeper (the only part that talks to the network)
After=yrl-audit.service yrl-executor.service yrl-firewall.service
Wants=yrl-audit.service yrl-executor.service yrl-firewall.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=yrl-gate
Group=yrl-gate
SupplementaryGroups=yrl-conf yrl-to-audit yrl-to-exec yrl-to-fw
EnvironmentFile=/etc/yrl/yrl.env
Environment=YRL_RUN=/run/yrl
ExecStart=/usr/local/bin/yrld gatekeeper /var/lib/yrl ${YRL_BIND} --spa ${YRL_SPA} --work-port ${YRL_PORT} --knock-ttl ${YRL_KNOCK_TTL}
Restart=on-failure
RestartSec=2
OOMPolicy=stop
MemoryHigh=512M
MemoryMax=1G
TasksMax=1024
CPUWeight=100
IOWeight=100
MemoryAccounting=yes
TasksAccounting=yes
CPUAccounting=yes
IOAccounting=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/yrl/enroll
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
LimitCORE=0
KillMode=control-group
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=yrl.target
