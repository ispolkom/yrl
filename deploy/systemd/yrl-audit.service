[Unit]
Description=YRL audit journal (hash chain, signed checkpoints)
Documentation=file:///usr/share/doc/yrl/INSTALL.md

[Service]
Type=simple
User=yrl-audit
Group=yrl-audit
SupplementaryGroups=yrl-to-audit
Environment=YRL_RUN=/run/yrl
Environment=YRL_SOCKET_GROUP=yrl-to-audit
ExecStart=/usr/local/bin/yrld audit /var/lib/yrl
Restart=on-failure
RestartSec=2
CapabilityBoundingSet=
ReadWritePaths=/var/lib/yrl/audit /run/yrl/audit
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=yrl.target
