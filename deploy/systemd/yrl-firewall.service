[Unit]
Description=YRL firewall program (the only one that changes the packet filter)
After=yrl-audit.service network-pre.target
Before=network.target
Requires=yrl-audit.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=yrl-fw
Group=yrl-fw
SupplementaryGroups=yrl-to-audit yrl-to-fw
EnvironmentFile=/etc/yrl/yrl.env
Environment=YRL_RUN=/run/yrl
Environment=YRL_SOCKET_GROUP=yrl-to-fw
ExecStart=/usr/local/bin/yrld firewall /var/lib/yrl --ports ${YRL_PORT} --gate-uid yrl-gate --gate-exe - --max-ttl 120
Restart=on-failure
RestartSec=2
OOMPolicy=stop
MemoryHigh=128M
MemoryMax=256M
TasksMax=128
CPUWeight=100
IOWeight=100
MemoryAccounting=yes
TasksAccounting=yes
CPUAccounting=yes
IOAccounting=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ReadWritePaths=/run/yrl/fw
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes
LimitCORE=0
KillMode=control-group
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=yrl.target
