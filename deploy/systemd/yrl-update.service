[Unit]
Description=YRL manually requested signed release update
ConditionPathExists=/etc/yrl/update.env
After=yrl-audit.service
Wants=yrl-audit.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=yrl-to-audit
Environment=YRL_RUN=/run/yrl
Environment=YRL_UPDATE_RESTRICTED_HEALTH=1
EnvironmentFile=/etc/yrl/update.env
ExecStartPre=+/opt/yrl/current/yrld install check /var/lib/yrl /run/yrl
ExecStart=/opt/yrl/current/yrl-update apply ${YRL_UPDATE_BUNDLE} /etc/yrl/release-trust /opt/yrl /var/lib/yrl-update /var/lib/yrl
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/yrl /var/lib/yrl-update
StateDirectory=yrl-update
StateDirectoryMode=0700
ReadOnlyPaths=/var/lib/yrl /etc/yrl/release-trust
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LimitCORE=0

# Deliberately static: no [Install] section, timer, network client or automatic enablement.
